# One-command shortcuts for the whole lab. Run from the repository root.
#
#   make up      build + start everything, wait for the tables, load demo data
#   make run     same as make up
#   make down    stop everything (data is kept)
#   make reset   stop, DELETE ALL DATA, then `make up` again
#   make seed    load demo data again (safe to repeat)
#   make logs    follow the logs of the four services
#   make ps      show container status
#   make test    run the unit tests of all four services
#
# Only Docker is needed. On the first run, `make up` creates a git-ignored
# .env with random local credentials (see the .env rule below).

SERVICES := author category book user

# Tests run in a Go 1.23 container, so the local Go version does not matter.
# The go-mod-cache volume keeps downloaded modules between runs.
GO_IMAGE := golang:1.23
GO_RUN   := docker run --rm -v "$(CURDIR)":/src -v library-go-mod-cache:/go/pkg/mod -w /src $(GO_IMAGE)

.PHONY: up run down reset seed logs ps test

# random hex string of $(1) bytes, from the OS random generator
random = $$(head -c $(1) /dev/urandom | od -An -tx1 | tr -d ' \n')

# First run only: docker-compose.yml needs DB_USER, DB_PASSWORD and JWT_SECRET.
# This creates them with random values, readable only by you (umask 077),
# and never prints them. The file is git-ignored. If it already exists it is
# left alone. No ADMIN_EMAIL here: log in with the seeded demo admin instead.
#
# The database password is stored in the volume on first start. If you delete
# .env, run `make reset` so the databases are recreated with the new password.
.env:
	@echo "creating .env with random local credentials (git-ignored, not printed)"
	@umask 077; { \
	  echo "# Generated by make. Local lab only."; \
	  echo "DB_USER=library"; \
	  echo "DB_PASSWORD=$(call random,16)"; \
	  echo "JWT_SECRET=$(call random,32)"; \
	  echo "JWT_TTL=24h"; \
	} > .env

up: .env
	docker compose up -d --build
	sh db/seed.sh
	@echo ""
	@echo "API:   http://localhost:6006   (spec: /openapi/library.swagger.json)"
	@echo "Login: POST /api/login with librarian@example.com / password123 (admin)"

run: up

down:
	docker compose down

# -v removes the database volumes: every row is deleted.
reset: .env
	docker compose down -v
	$(MAKE) up

seed:
	sh db/seed.sh

logs:
	docker compose logs -f $(addsuffix -service,$(SERVICES))

ps:
	docker compose ps

test:
	$(GO_RUN) sh -c 'for s in $(SERVICES); do echo "== $$s-service"; (cd $$s-service && go test ./...) || exit 1; done'
