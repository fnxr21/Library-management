{
  "info": {
    "name": "Library Management",
    "description": "REST API of the Library Management lab. Everything goes through the gateway (user-service).\n\n**Setup**\n1. Start the stack: `make run`\n2. Run **Auth → Login (admin)**: it stores the JWT in `{{lm-token}}` automatically.\n3. Call anything else.\n\n**Variables** (collection variables, edit under the collection's *Variables* tab)\n- `lm-url`: gateway address, default `http://localhost:6006`\n- `lm-token`: JWT, set by the login requests\n- `lm-author-id`, `lm-category-id`, `lm-book-id`: ids of rows created by the *Create* requests, so Update/Delete never touch the seed data\n\nEvery request sends `Authorization: Bearer {{lm-token}}` (collection-level auth) unless it is marked *No Auth*.\n\n**Run all**: the folders are ordered so *Run collection* works top to bottom; each request has tests.\n\nDemo accounts (password `password123`): `librarian@example.com` (admin), `budi@example.com`, `siti@example.com`, `andi@example.com` (members).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{lm-token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "lm-url",
      "value": "http://localhost:6006",
      "type": "string"
    },
    {
      "key": "lm-token",
      "value": "",
      "type": "string"
    },
    {
      "key": "lm-author-id",
      "value": "",
      "type": "string"
    },
    {
      "key": "lm-category-id",
      "value": "",
      "type": "string"
    },
    {
      "key": "lm-book-id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Public endpoints, no token needed.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{lm-url}}/healthz",
              "host": [
                "{{lm-url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{lm-url}}/openapi/library.swagger.json",
              "host": [
                "{{lm-url}}"
              ],
              "path": [
                "openapi",
                "library.swagger.json"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "The full API spec, generated from the .proto files. Import it into Postman or Swagger UI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Register and log in. Login stores the token in `{{lm-token}}`.",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{lm-url}}/api/login",
              "host": [
                "{{lm-url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Seeded demo admin. Stores the JWT in `{{lm-token}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "// Store the JWT so every other request sends it as {{lm-token}}.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"lm-token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (new member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{lm-url}}/api/register",
              "host": [
                "{{lm-url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman-user\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a member account. `{{$timestamp}}` makes the email unique each run. Registering an existing email returns 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{lm-url}}/api/me",
              "host": [
                "{{lm-url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "Returns the user identified by `{{lm-token}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
